[sub_resource type="Shader" id="Shader_htfm3"]
code = "shader_type canvas_item;
uniform sampler2D c : filter_linear, repeat_disable;
uniform vec2 vel;
uniform vec3 col : source_color;
uniform float s=1.;
void fragment() {
	vec2 _uv = vec2(-.5)+UV+(vel*s*0.001);
	float uv_d = length(_uv);
	float _uv_d = texture(c,vec2(uv_d)).x;
	COLOR += vec4(
		col*_uv_d,
		0.);
}"

